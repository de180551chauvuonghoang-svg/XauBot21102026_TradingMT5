# ============================================================
#  TEMPLATE — Copy file này thành .env và điền thông tin thật
#  File này AN TOÀN để commit lên GitHub
# ============================================================

# ---- MT5 Account Credentials ----
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# ---- Telegram Bot ----
# Lấy token từ @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=
# Lấy chat_id từ @userinfobot
TELEGRAM_CHAT_ID=

# ---- LLM / AI APIs ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ---- Chế độ giao dịch: demo | live ----
TRADING_MODE=demo
